# ==============================================================================
# Charity Draws - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values for your environment.

# Database Configuration (PostgreSQL connection string)
DATABASE_URL="postgresql://charity_user:your_password@localhost:5432/charity_prod"

# NestJS Server Configuration
PORT=5000
NODE_ENV="development" # development | production | test
APP_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"

# JWT & Authentication Security
JWT_SECRET="change-this-to-a-secure-random-secret-key"
JWT_EXPIRES_IN="7d"

# Rate Limiting Guard
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Email (SMTP Provider / Google App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@charitydraws.co.uk"
SMTP_PASSWORD="your-smtp-app-password"
FROM_EMAIL="Charity Draws <notifications@charitydraws.co.uk>"

# Cashflows Payment Gateway Configuration
CASHFLOWS_CONFIGURATION_ID="your_cashflows_configuration_id"
CASHFLOWS_API_KEY="your_cashflows_api_key"
CASHFLOWS_BASE_URL="https://gateway.cashflows.com" # https://gateway-int.cashflows.com for testing
CASHFLOWS_WEBHOOK_SECRET="your_webhook_secret"

# Payment Simulation Mode (Set to "true" for local dev/testing without live payment gateway)
USE_TEST_PAYMENT="true"
